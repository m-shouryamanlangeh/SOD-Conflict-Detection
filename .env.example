# Copy this file to .env (or .env.local) and fill in the value below.
#
# n8n form-trigger webhook URL. Take it from the "On Form Submission4"
# node in SAP SOD Project (Live).json — webhookId is
# 92662720-a8cb-465d-9bef-6751cf7e55fd.
#
# For self-hosted n8n:
#   https://<your-n8n-host>/form/92662720-a8cb-465d-9bef-6751cf7e55fd
# For a production webhook with a custom path:
#   https://<your-n8n-host>/webhook/<custom-path>
VITE_N8N_WEBHOOK_URL=
